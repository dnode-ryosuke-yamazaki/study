<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  議事録生成バッチを10分間隔で実行する launchd の定義。

  登録手順・解除手順は ../../README.md を参照。
  `__ホームディレクトリ__` は登録時に実際のパスへ置き換える(README参照)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.meeting-minutes-generator</string>

  <!--
    Pythonを絶対パスで書く。launchdはログインシェルのPATHを継承しないため
    名前では起動できず、`/usr/bin/python3` はApple標準の3.9でこのコードが使う
    3.10以降の書き方を解釈できない。

    バージョン番号込みのパス(`Versions/3.13/...`)を書いてはいけない。Pythonを
    上げると指し先が消え、launchdがプロセスを起動できなくなる。このとき
    minutes.logにも下の StandardErrorPath にも1行も残らないため、静かに止まった
    ことに気づけない。最新版へのsymlinkである `Versions/Current` を経由する。
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/Current/bin/python3</string>
    <string>__ホームディレクトリ__/repo/study/apps/meeting-minutes-generator/application/generate_minutes.py</string>
  </array>

  <!-- 仕様: design.md#定期実行と未処理VTTの検知(10分間隔) -->
  <key>StartInterval</key>
  <integer>600</integer>

  <!-- 起動時にも1回走らせる。スリープ復帰後の取り残しを早めに拾うため。 -->
  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__ホームディレクトリ__/repo/study/apps/meeting-minutes-generator/application</string>

  <!--
    標準出力・標準エラーの行き先。通常のログは
    ~/Library/Application Support/meeting-minutes-generator/minutes.log に出る。
    ここに出るのはPythonが起動できなかった場合などの想定外の出力だけ。
  -->
  <key>StandardOutPath</key>
  <string>__ホームディレクトリ__/Library/Logs/meeting-minutes-generator.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ホームディレクトリ__/Library/Logs/meeting-minutes-generator.err.log</string>
</dict>
</plist>
