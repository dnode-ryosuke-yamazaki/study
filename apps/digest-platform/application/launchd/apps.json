{
  "apps": {
    "ai-dev-digest": {
      "publish": {
        "enabled": false,
        "weekdays": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "editionByWeekday": null,
        "maxAttempts": 4,
        "command": [
          "{node}",
          "{tsx}",
          "../../ai-dev-digest/application/batch/publish.ts"
        ],
        "artifacts": [
          "../../ai-dev-digest/application/articles/{date}{edition}.json",
          "out/ai-dev-digest/{date}{edition}/index.html"
        ]
      },
      "review": {
        "dayOfMonth": null,
        "maxAttempts": 1,
        "command": [
          "{node}",
          "{tsx}",
          "../../ai-dev-digest/application/batch/review.ts"
        ],
        "artifacts": [
          "../../ai-dev-digest/application/reviews/{yearMonth}.md"
        ]
      }
    },
